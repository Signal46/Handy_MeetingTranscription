{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the app",
  "windows": ["main", "recording_overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "updater:default",
    "process:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "macos-permissions:default",
    "fs:read-files",
    "fs:allow-resource-read-recursive",
    {
      "identifier": "fs:allow-app-data-read",
      "allow": [{ "path": "$APP_DATA/*" }]
    },
    {
      "identifier": "fs:allow-app-data-write",
      "allow": [{ "path": "$APP_DATA/*" }]
    },
    {
      "identifier": "fs:allow-app-temp-read",
      "allow": [{ "path": "$APP_TEMP/*" }]
    },
    {
      "identifier": "fs:allow-app-temp-write",
      "allow": [{ "path": "$APP_TEMP/*" }]
    }
  ]
}
